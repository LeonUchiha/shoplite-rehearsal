# Copy nothing from here into a commit. Set this in your shell, not in a file:
#   PowerShell:  $env:GITHUB_PERSONAL_ACCESS_TOKEN = "<fine-grained PAT>"
#   bash:        export GITHUB_PERSONAL_ACCESS_TOKEN="<fine-grained PAT>"
# Fine-grained PAT scope: this one repository only ->
#   Contents: Read, Pull requests: Read and write, Metadata: Read
GITHUB_PERSONAL_ACCESS_TOKEN=
